# BuilderConnect Backend — local secrets template
# =================================================
# Copy this file to backend/.env and fill in real values. NEVER commit backend/.env.
# Loaded automatically by spring-dotenv when the backend starts from /backend.
# (There is intentionally NO root-level .env — nothing reads one. Backend env lives
# here; frontend env lives in frontend/.env — see frontend/.env.example.)

# --- Core (required for prod; dev has safe defaults in application-dev.yml) ---

# JWT signing secret — signs/verifies every access & refresh token (jjwt HMAC).
# Anyone holding this value can forge logins for any user, so in prod it must be
# random and at least 256 bits (32+ bytes). Generate one:  openssl rand -base64 48
# Dev boots WITHOUT this (application-dev.yml ships a dev-only default).
JWT_SECRET=replace-with-a-strong-random-secret-at-least-256-bits

# MySQL database (prod; dev uses in-memory H2 automatically)
DB_URL=jdbc:mysql://localhost:3306/builderconnect?useSSL=true&serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USERNAME=builderconnect_user
DB_PASSWORD=replace-with-strong-password

# Spring profile (dev | prod). Base config defaults to dev — ALWAYS set prod for
# any non-local deployment or the app silently boots on H2 + the dev JWT secret.
SPRING_PROFILES_ACTIVE=dev

# Frontend URL (CORS, email links, Stripe checkout redirect URLs)
FRONTEND_URL=http://localhost:5173

# --- SMTP / outgoing mail (587 = STARTTLS, 465 = implicit SSL) ---
# Leave MAIL_HOST blank/unset to fall back to the mock mailer (localhost:1025).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@yourdomain.com
MAIL_AUTH=true
# Port 587 -> STARTTLS (MAIL_STARTTLS=true, MAIL_SSL=false).
# Port 465 -> implicit SSL (MAIL_STARTTLS=false, MAIL_SSL=true).
MAIL_STARTTLS=true
MAIL_SSL=false

# If your SMTP password contains characters dotenv can't parse (e.g. '#' or '"'), DON'T use
# MAIL_PASSWORD above — instead base64-encode it and set MAIL_PASSWORD_B64 (decoded at startup
# by MailPasswordDecoder). Generate with:  printf '%s' 'YOUR_PASSWORD' | base64
# MAIL_PASSWORD_B64=

# --- Stripe (TEST mode) — keys from https://dashboard.stripe.com/test/apikeys ---
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` output (dev):
#   stripe listen --forward-to localhost:8080/api/v1/webhooks/stripe
# or from the dashboard webhook endpoint (prod). Stripe keys contain no '#'/quotes,
# so no base64 encoding is needed. Both optional: without them, subscription
# checkout endpoints return 400 "Stripe is not configured on this server".
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --- AI provider (FAQ chatbot + AI Assistant + floor-plan generation) ---
# Choose the provider: `gemini` (free tier) or `anthropic` (paid). Whichever is
# selected must have its key set below; a blank/misconfigured key makes the AI
# features report themselves unavailable and hide in the UI.
LLM_PROVIDER=gemini

# Gemini — free key from https://aistudio.google.com/apikey (used when LLM_PROVIDER=gemini).
# Optionally pin a model with GEMINI_MODEL (default gemini-flash-latest).
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-flash-latest

# Anthropic / Claude — key from https://console.anthropic.com (used when LLM_PROVIDER=anthropic).
# PAID API (no free tier). Optionally pin a model with ANTHROPIC_MODEL (default claude-haiku-4-5-20251001).
ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Google Maps Platform — locality/area autocomplete (Places API) ---
# Server-side proxy for the project-creation "Locality / Area" field, so the key never
# reaches the browser. Enable "Places API" for the key and restrict it (API + optionally IP).
# Optional: without it, the locality field still works as free text.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Optional model override (default gemini-flash-latest). Some free-tier projects
# have zero quota on specific versioned models but quota on the "latest" alias.
# GEMINI_MODEL=gemini-flash-latest
