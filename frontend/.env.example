# BuilderConnect Frontend — env template
# ========================================
# Copy this file to frontend/.env if you need to override defaults. NEVER commit frontend/.env.
# Vite only exposes variables prefixed with VITE_ to the app bundle — anything here is
# PUBLIC once built, so no real secrets belong in this file.

# API base URL. Not needed in dev (vite.config.ts proxies /api -> http://localhost:8080).
# Set only when the frontend is served separately from the backend.
# VITE_API_URL=http://localhost:8080/api

# Stripe PUBLISHABLE key (pk_test_...) — public by design.
# NOT used by the current integration (hosted Checkout is a full-page redirect and needs
# no Stripe.js). Kept here for a future embedded Elements payment form.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
