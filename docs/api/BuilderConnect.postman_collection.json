{
  "info": {
    "name": "BuilderConnect API",
    "description": "Smart Construction Marketplace & Project Lifecycle Management Platform",
    "_postman_id": "builderconnect-api-v2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register - Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}",
                  "",
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has tokens', function () {",
                  "    pm.expect(jsonData).to.have.property('accessToken');",
                  "    pm.expect(jsonData).to.have.property('refreshToken');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newclient@test.com\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"New\",\n  \"lastName\": \"Client\",\n  \"phone\": \"+923001234567\",\n  \"role\": \"CLIENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login - Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has user info', function () {",
                  "    pm.expect(jsonData.user).to.have.property('email');",
                  "    pm.expect(jsonData.user).to.have.property('role');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"client@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - Builder",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"builder@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Projects - Client",
      "item": [
        {
          "name": "Create Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('projectId', jsonData.id);",
                  "}",
                  "",
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Kitchen Renovation in DHA Phase 5\",\n  \"description\": \"Complete kitchen renovation including cabinets, countertops, tiles, and appliances installation. Looking for experienced contractors.\",\n  \"categoryId\": 4,\n  \"city\": \"Karachi\",\n  \"locationAddress\": \"House 123, Street 5, DHA Phase 5\",\n  \"budgetMin\": 200000,\n  \"budgetMax\": 350000,\n  \"deadline\": \"2024-04-15\",\n  \"isUrgent\": false,\n  \"requiresInspection\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/client/projects",
              "host": ["{{baseUrl}}"],
              "path": ["client", "projects"]
            }
          }
        },
        {
          "name": "Get My Projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/client/projects?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["client", "projects"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Project Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/client/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["client", "projects", "{{projectId}}"]
            }
          }
        },
        {
          "name": "Publish Project",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/client/projects/{{projectId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["client", "projects", "{{projectId}}", "publish"]
            }
          }
        },
        {
          "name": "Award Project",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/client/projects/{{projectId}}/award/{{bidId}}",
              "host": ["{{baseUrl}}"],
              "path": ["client", "projects", "{{projectId}}", "award", "{{bidId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Projects - Marketplace",
      "item": [
        {
          "name": "Search Projects",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects?city=Karachi&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["projects"],
              "query": [
                {
                  "key": "city",
                  "value": "Karachi"
                },
                {
                  "key": "categoryId",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "minBudget",
                  "value": "50000",
                  "disabled": true
                },
                {
                  "key": "maxBudget",
                  "value": "500000",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Public Project Details",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/1",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Bids - Builder",
      "item": [
        {
          "name": "Submit Bid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('bidId', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 280000,\n  \"proposal\": \"I am an experienced kitchen renovation specialist with 10+ years of experience. I will complete this project with high-quality materials and professional workmanship.\",\n  \"estimatedDuration\": 30,\n  \"milestones\": [\n    {\n      \"title\": \"Demolition & Preparation\",\n      \"description\": \"Remove existing fixtures and prepare space\",\n      \"amount\": 50000,\n      \"dueDate\": \"2024-03-01\"\n    },\n    {\n      \"title\": \"Cabinet Installation\",\n      \"description\": \"Install new kitchen cabinets\",\n      \"amount\": 100000,\n      \"dueDate\": \"2024-03-15\"\n    },\n    {\n      \"title\": \"Countertops & Finishing\",\n      \"description\": \"Install countertops and complete finishing\",\n      \"amount\": 130000,\n      \"dueDate\": \"2024-04-01\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/1/bids",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "1", "bids"]
            }
          }
        },
        {
          "name": "Get My Bids",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/builder/bids?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["builder", "bids"],
              "query": [
                {
                  "key": "status",
                  "value": "SUBMITTED",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Project Bids",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/1/bids",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "1", "bids"]
            }
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Get Chat Rooms",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "rooms"]
            }
          }
        },
        {
          "name": "Create/Get Direct Room",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('chatRoomId', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/rooms/direct/2",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "rooms", "direct", "2"]
            }
          }
        },
        {
          "name": "Get Room Messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/rooms/{{chatRoomId}}/messages?page=0&size=50",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "rooms", "{{chatRoomId}}", "messages"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello! I'm interested in discussing the project details.\",\n  \"messageType\": \"TEXT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/rooms/{{chatRoomId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "rooms", "{{chatRoomId}}", "messages"]
            }
          }
        },
        {
          "name": "Mark Messages as Read",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/rooms/{{chatRoomId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "rooms", "{{chatRoomId}}", "read"]
            }
          }
        },
        {
          "name": "Get Unread Count",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/unread-count",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "unread-count"]
            }
          }
        }
      ]
    }
  ]
}
